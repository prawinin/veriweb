# Run local services through scripts/dev.py. All ports can be overridden.
HOST=127.0.0.1
PORT=3000
VERIWEB_API_HOST=127.0.0.1
VERIWEB_API_PORT=8000

# Omit MODEL_URL for retrieval-only operation. Supply an API base ending in /v1.
# VERIWEB_MODEL_URL=http://127.0.0.1:8080/v1
VERIWEB_MODEL_NAME=local-model
VERIWEB_MODEL_BACKEND=unverified
VERIWEB_MODEL_HOST=127.0.0.1
VERIWEB_MODEL_PORT=8080
# VERIWEB_GGUF_PATH=models/llm/qwen2.5-1.5b-instruct-q4_k_m.gguf
VERIWEB_GPU_LAYERS=0
# VERIWEB_GPU_DEVICE=your-device-from-list-devices
VERIWEB_MODEL_CONTEXT=8192
VERIWEB_MODEL_TIMEOUT=120
# VERIWEB_MODEL_KEY=your-endpoint-key
# VERIWEB_LLAMA_SERVER=path-to-compatible-llama-server

# Download first with scripts/setup_models.py; omit to use BM25 only.
# VERIWEB_EMBEDDINGS_MODEL=models/bge-small-en-v1.5
VERIWEB_EMBEDDINGS_DEVICE=cpu
VERIWEB_EMBEDDING_CANDIDATES=96

# Optional paid/free-tier search; keyless DDGS is the default.
# VERIWEB_TAVILY_KEY=your-tavily-key
VERIWEB_TAVILY_URL=https://api.tavily.com/search
VERIWEB_SEARCH_TIMEOUT=15
VERIWEB_FETCH_TIMEOUT=12
VERIWEB_MAX_SOURCES=8
VERIWEB_FOLLOW_LINKS=2
VERIWEB_RUN_TIMEOUT=360

# Optional native ROCm container runtime; local GGUF/Vulkan remains separate.
# Use an existing Transformers model directory/cache, or explicitly opt into downloads.
VERIWEB_AMD_MODEL=Qwen/Qwen2.5-1.5B-Instruct
VERIWEB_AMD_ALLOW_DOWNLOAD=false
VERIWEB_AMD_MODEL_NAME=veriweb-rocm
VERIWEB_AMD_HOST=127.0.0.1
VERIWEB_AMD_PORT=0
VERIWEB_AMD_CONTEXT=8192
VERIWEB_AMD_MAX_TOKENS=1600
VERIWEB_AMD_REQUEST_TIMEOUT=120
VERIWEB_AMD_STARTUP_TIMEOUT=540
VERIWEB_AMD_MEMORY_FRACTION=0.85
VERIWEB_AMD_THREADS=6
# VERIWEB_AMD_RUNTIME_FILE=output/runtime.json

# Usually unnecessary with the same-origin Next.js proxy.
VERIWEB_CORS_ORIGINS=[]
# VERIWEB_PUBLIC_ORIGIN=https://your-deployment.example
# VERIWEB_API_URL=http://your-api-service:8000
